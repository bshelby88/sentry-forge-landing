# Webhook Forge Starter Kit — env vars
# Copy this file to .env.local and fill in your real values.
# Add the same three vars to your Vercel project settings (Production environment).

# Stripe webhook signing secret. Get from:
# Stripe Dashboard → Developers → Webhooks → click your endpoint → "Signing secret" → reveal
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# Resend API key. Get from: resend.com/api-keys
RESEND_API_KEY=re_REPLACE_ME

# Where [FORGE PAID] notifications and forwarded customer emails land.
FOUNDER_EMAIL=you@example.com
